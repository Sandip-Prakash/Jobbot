# Set these as GitHub Actions secrets (Settings -> Secrets and variables -> Actions). Never commit real values.
ANTHROPIC_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=       # create with: python -m jobbot.cli init-notion --parent <notion page id>
APOLLO_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=      # get with: python scripts/gmail_auth.py  (scope: gmail.send only)
NOTIFY_EMAIL=             # where active-thread flags are sent (your own address)
# Repo VARIABLE (not secret): JOBBOT_MODE = dry_run | live   (unset = dry_run)
